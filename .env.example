# Set these in the process environment; Django and the CLI do not load .env.
# Use demo explicitly for scripted, offline API replies.
AKIM_AI_PROVIDER=openai
OPENAI_API_KEY=
# Use a model available to your account with Responses + Structured Outputs support.
OPENAI_MODEL=

# These defaults are already configured in Django:
GAME_CATALOG_PROVIDER=akim_ai.agent.load_catalog
ADVISOR_REPLY_PROVIDER=game_api.integrations.reply
# Set this once the teammate's scoring engine is available:
GAME_SIMULATION_PROVIDER=
