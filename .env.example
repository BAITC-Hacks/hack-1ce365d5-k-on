# Django loads the repository .env; existing process environment values win.
# The standalone Advisor CLI still requires these in the process environment.
# Use demo explicitly for scripted, offline API replies.
AKIM_AI_PROVIDER=openai
OPENAI_API_KEY=
# Use a model available to your account with Responses + Structured Outputs support.
OPENAI_MODEL=

# These defaults are already configured in Django:
GAME_CATALOG_PROVIDER=akim_ai.agent.load_catalog
ADVISOR_REPLY_PROVIDER=game_api.integrations.reply
# Override only when connecting a different scoring engine:
GAME_SIMULATION_PROVIDER=game_api.engine.simulate

# Optional Vite development/preview proxy target (never exposed as a VITE_ key):
DJANGO_API_TARGET=http://127.0.0.1:8000
